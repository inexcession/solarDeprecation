# =====================================================================
# Octopus Energy Japan & VictoriaMetrics Environment Configuration
# =====================================================================
# Copy this file to .env and fill in your values.
# .env is ignored by git and will never be committed.

# --- Octopus Energy Japan Authentication ---
# The Kraken GraphQL API (https://api.oejp-kraken.energy/v1/graphql/)
# authenticates with your Octopus Energy portal email and password.
OCTOPUS_EMAIL="your-email@example.com"
OCTOPUS_PASSWORD="your-octopus-portal-password"
OCTOPUS_ACCOUNT_NUMBER="A-XXXXXXXX"

# Optional: If you have an API key, it will take precedence over email/password
# OCTOPUS_API_KEY=""

# --- Local Infrastructure ---
# VictoriaMetrics endpoint for solar generation and CT clamp export
VM_HOST="http://192.168.0.250:8428"
