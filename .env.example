# =====================================================================
# Octopus Energy Japan & VictoriaMetrics Environment Configuration
# =====================================================================
# Copy this file to .env and fill in your values.
# .env is ignored by git and will never be committed.

# --- Octopus Energy Japan Authentication ---
# The Kraken GraphQL API (https://api.oejp-kraken.energy/v1/graphql/)
# authenticates with your standard Octopus Energy portal email and password.
OCTOPUS_EMAIL="your-email@example.com"
OCTOPUS_PASSWORD="your-octopus-portal-password"
OCTOPUS_ACCOUNT_NUMBER="A-XXXXXXXX"

# Optional: If you have an API key, it will take precedence over email/password
# OCTOPUS_API_KEY=""

# --- Contract & Tariff Settings ---
# Effective switch month to Octopus Energy Japan
OCTOPUS_SWITCH_MONTH="2026-11"

# Simple Octopus 24/7 Fixed Energy Rate (¥/kWh)
OCTOPUS_BASE_RATE=31.93

# National Renewable Energy Surcharge / 再生可能エネルギー発電促進賦課金 (¥/kWh)
# Added to every kWh drawn from the grid (e.g. 3.49 for FY2026)
RENEWABLE_SURCHARGE=3.49

# Estimated non-FIT surplus export unit price (¥/kWh)
# Paid out biannually by TEPCO for surplus solar power (approx. ¥8.5/kWh)
# Used only as an estimate when running mid-month before TEPCO CSV arrives.
SURPLUS_EXPORT_RATE=8.50

# --- Local Infrastructure ---
# VictoriaMetrics endpoint for solar generation and CT clamp export
VM_HOST="http://192.168.0.250:8428"
